# Supabase Postgres connection string. Use the transaction pooler URL for runtime.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Use the session pooler or direct DB URL for Prisma schema sync/migrations.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres"

# Optional. Used to raise GitHub API rate limits for public repositories.
GITHUB_TOKEN=""

# Set one or both for live AI analysis. Without a key, local heuristic analysis is used.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-mini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Keep true for classroom demos without paid API keys.
ALLOW_HEURISTIC_FALLBACK="true"
